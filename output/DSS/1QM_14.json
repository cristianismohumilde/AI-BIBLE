[
  {
    "verse": 1,
    "original": "בְּכֵן יְבָרְכוּ",
    "transliteration": "vekhen yevarekhv",
    "translation": "Assim os abençoará"
  },
  {
    "verse": 2,
    "original": "כֹּל הָרוּחוֹת הַנֶּאֱמָנִים",
    "transliteration": "khol harvhvot hane'emaniym",
    "translation": "Todos os espíritos fiéis"
  },
  {
    "verse": 3,
    "original": "בְּחַגֵּי הַשָּׁנָה",
    "transliteration": "vehagey hasahnah",
    "translation": "Nos festivais do ano"
  },
  {
    "verse": 4,
    "original": "וּמוֹעֲדֵי עוֹלָם",
    "transliteration": "vmvo'adey 'volam",
    "translation": "e as assembleias eternas"
  },
  {
    "verse": 5,
    "original": "בְּרֹאשׁ הַחֳדָשִׁים",
    "transliteration": "vero'sh hahodasihym",
    "translation": "No início dos meses"
  },
  {
    "verse": 6,
    "original": "וּבִימֵי הַשַּׁבָּת",
    "transliteration": "vviymey hasahvat",
    "translation": "E nos dias do Sabbath"
  },
  {
    "verse": 7,
    "original": "וְכָל יְמֵי הַמּוֹעֵד",
    "transliteration": "vekhal yemey hamvo'ed",
    "translation": "E todos os dias da festa"
  },
  {
    "verse": 8,
    "original": "תְּרוּמַת שְׂפָתֵינוּ",
    "transliteration": "tervmat sefateynv",
    "translation": "Oferta de nossos lábios"
  },
  {
    "verse": 9,
    "original": "בְּמִשְׁפָּטֵי אֱמֶת",
    "transliteration": "vemisehfatey 'emet",
    "translation": "Pelos juízos da verdade"
  },
  {
    "verse": 10,
    "original": "לְבָרֵךְ שֵׁם הַקָּדוֹשׁ",
    "transliteration": "levarekhe sehm hakadvosh",
    "translation": "Bendizer o nome do Santo"
  }
]