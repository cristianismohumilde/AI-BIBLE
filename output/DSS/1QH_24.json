[
  {
    "verse": 1,
    "original": "אוֹדְךָ אֲדֹנָי",
    "transliteration": "'vodekha 'adonay",
    "translation": "Te louvo, Senhor."
  },
  {
    "verse": 2,
    "original": "בְּרֹב חֶסֶד",
    "transliteration": "verov hesed",
    "translation": "Pela grandeza da misericórdia"
  },
  {
    "verse": 3,
    "original": "עֲנִיתָנִי",
    "transliteration": "'aniytaniy",
    "translation": "Tu me afligiste"
  },
  {
    "verse": 4,
    "original": "וְרַחֲמֶיךָ",
    "transliteration": "verahameykha",
    "translation": "e teus misericórdias"
  },
  {
    "verse": 5,
    "original": "לֹא כָלוּ",
    "transliteration": "lo' khalv",
    "translation": "Não foram consumidos"
  },
  {
    "verse": 6,
    "original": "מֵאָז וְעַד",
    "transliteration": "me'az ve'ad",
    "translation": "desde então até"
  },
  {
    "verse": 7,
    "original": "עוֹלָם",
    "transliteration": "'volam",
    "translation": "Eternidade"
  },
  {
    "verse": 8,
    "original": "וּמֵאֹהֶל",
    "transliteration": "vme'ohel",
    "translation": "e da tenda"
  },
  {
    "verse": 9,
    "original": "לֹא הִסְתַּרְתָּ",
    "transliteration": "lo' hisetareta",
    "translation": "Não ocultaste"
  },
  {
    "verse": 10,
    "original": "פָּנֶיךָ",
    "transliteration": "faneykha",
    "translation": "Tua face"
  }
]