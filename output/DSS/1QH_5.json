[
  {
    "verse": 1,
    "original": "אוֹדְךָ אֲדֹנָי",
    "transliteration": "'vodekha 'adonay",
    "translation": "Te louvarei, Senhor."
  },
  {
    "verse": 2,
    "original": "כִּי לֹא נְטַשְׁתַּנִי",
    "transliteration": "khiy lo' netasehtaniy",
    "translation": "Porque não me abandonaste"
  },
  {
    "verse": 3,
    "original": "בְּגוּרִי בְּאֶרֶץ נֵכָר",
    "transliteration": "vegvriy ve'erets nekhar",
    "translation": "Na minha habitação na terra dos estrangeiros..."
  },
  {
    "verse": 4,
    "original": "וְלֹא הִסְגַּרְתַּנִי",
    "transliteration": "velo' hisegaretaniy",
    "translation": "e não me encerrou"
  },
  {
    "verse": 5,
    "original": "בְּיַד אוֹיְבַי",
    "transliteration": "veyad 'voyevay",
    "translation": "Na mão dos meus inimigos..."
  },
  {
    "verse": 6,
    "original": "כִּי הָיִיתִי",
    "transliteration": "khiy hayiytiy",
    "translation": "Porque fui"
  },
  {
    "verse": 7,
    "original": "בְּמָצוֹר מֵצַר",
    "transliteration": "vematsvor metsar",
    "translation": "Na angústia da aflição"
  },
  {
    "verse": 8,
    "original": "וְאַתָּה אֵלִי",
    "transliteration": "ve'atah 'eliy",
    "translation": "E tu, meu Deus,"
  },
  {
    "verse": 9,
    "original": "שָׁלַחְתָּ לִי שַׁעֲרֵי אוֹר",
    "transliteration": "sahlaheta liy sah'arey 'vor",
    "translation": "Enviaste-me as portas da luz..."
  },
  {
    "verse": 10,
    "original": "לְהַאִיר דַּרְכִּי",
    "transliteration": "leha'iyr darekhiy",
    "translation": "iluminar meu caminho"
  }
]