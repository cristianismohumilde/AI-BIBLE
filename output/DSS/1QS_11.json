[
  {
    "verse": 1,
    "original": "מֵרֹאשׁ מוֹצָאָיו הוּא",
    "transliteration": "mero'sh mvotsa'ayv hv'",
    "translation": "Desde sua origem, ele é..."
  },
  {
    "verse": 2,
    "original": "בְּצֵאת הַשֶּׁמֶשׁ עַל הָאָרֶץ",
    "transliteration": "vetse't hasehmesh 'al ha'arets",
    "translation": "Na saída do sol sobre a terra..."
  },
  {
    "verse": 3,
    "original": "בְּמִלֹּאת הַשֶּׁמֶשׁ חֶשְׁבּוֹנָה",
    "transliteration": "vemilo't hasehmesh hesehvvonah",
    "translation": "Ao se por o sol, façam sua contagem."
  },
  {
    "verse": 4,
    "original": "אֲשֶׁר לֹא יָצָא מֵרֹאשׁ",
    "transliteration": "'asehr lo' yatsa' mero'sh",
    "translation": "que não saiu do começo"
  },
  {
    "verse": 5,
    "original": "כִּי מִמְּקוֹר צֶדֶק מִשְׁפָּטַי",
    "transliteration": "khiy mimekvor tsedek misehfatay",
    "translation": "Pois dos recessos da justiça vêm meus juízos."
  },
  {
    "verse": 6,
    "original": "וְאֵין עֲוֹן בְּלֵבָב",
    "transliteration": "ve'eyn 'avon velevav",
    "translation": "Não há pecado no coração."
  },
  {
    "verse": 7,
    "original": "כִּי לָאֵל הַצְּדָקָה",
    "transliteration": "khiy la'el hatsedakah",
    "translation": "Pois a justiça pertence a Deus"
  },
  {
    "verse": 8,
    "original": "וּבְיָדוֹ תַמִּים דֶּרֶךְ",
    "transliteration": "vveyadvo tamiym derekhe",
    "translation": "E em sua mão, o caminho é puro."
  },
  {
    "verse": 9,
    "original": "בְּדַעְתּוֹ כֹּל נִהְיֶה",
    "transliteration": "veda'etvo khol niheyeh",
    "translation": "Pela sua sabedoria, tudo se faz."
  },
  {
    "verse": 10,
    "original": "וּבְחָכְמָתוֹ יִכּוֹן כֹּל הָוֶה",
    "transliteration": "vvehakhematvo yikhvon khol haveh",
    "translation": "E em sua sabedoria será firmado todo o ser."
  },
  {
    "verse": 11,
    "original": "לִי אֵין מַשֵּׂא בָשָׂר",
    "transliteration": "liy 'eyn mase' vasar",
    "translation": "Não há fardo sobre minha carne"
  },
  {
    "verse": 12,
    "original": "כִּי לָאֵל צְדָקָה",
    "transliteration": "khiy la'el tsedakah",
    "translation": "Porque a Deus pertence a justiça"
  }
]