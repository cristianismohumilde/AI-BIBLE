[
  {
    "verse": 1,
    "original": "הַלֵּל לָאֵל",
    "transliteration": "halel la'el",
    "translation": "Louvor ao Deus"
  },
  {
    "verse": 2,
    "original": "אֲשֶׁר פָּדָה אֶת נַפְשׁוֹ",
    "transliteration": "'asehr fadah 'et nafeshvo",
    "translation": "que livrou sua alma"
  },
  {
    "verse": 3,
    "original": "מִשַּׁחַת",
    "transliteration": "misahhat",
    "translation": "Da pia santificadora"
  },
  {
    "verse": 4,
    "original": "וְהֶחֱיָהוּ",
    "transliteration": "veheheyahv",
    "translation": "e o vivificou"
  },
  {
    "verse": 5,
    "original": "בְּרֹב חֲסָדָיו",
    "transliteration": "verov hasadayv",
    "translation": "Pela abundância de seus favores"
  },
  {
    "verse": 6,
    "original": "אָכֵן יָדַעְתִּי",
    "transliteration": "'akhen yada'etiy",
    "translation": "Certamente conheci"
  },
  {
    "verse": 7,
    "original": "כִּי לָאֵל לְבַדּוֹ",
    "transliteration": "khiy la'el levadvo",
    "translation": "Pois para Deus somente"
  },
  {
    "verse": 8,
    "original": "הַצְּדָקָה",
    "transliteration": "hatsedakah",
    "translation": "A justiça"
  },
  {
    "verse": 9,
    "original": "לְמַעַן תֵּדְעוּ",
    "transliteration": "lema'an tede'v",
    "translation": "Para que vós saibais"
  },
  {
    "verse": 10,
    "original": "כִּי טוֹב אֵל",
    "transliteration": "khiy tvov 'el",
    "translation": "Pois bom é Deus"
  }
]