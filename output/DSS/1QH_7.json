[
  {
    "verse": 1,
    "original": "אוֹדְךָ אֲדֹנָי",
    "transliteration": "'vodekha 'adonay",
    "translation": "Te louvo, Senhor."
  },
  {
    "verse": 2,
    "original": "כִּי הִפְלֵאתָ",
    "transliteration": "khiy hifele'ta",
    "translation": "Pois tu me fizeste distinguir-me"
  },
  {
    "verse": 3,
    "original": "עִם עֹפָר",
    "transliteration": "'im 'ofar",
    "translation": "com pó"
  },
  {
    "verse": 4,
    "original": "בְּחֵינֶךָ הַגְּדוֹלָה",
    "transliteration": "veheynekha hagedvolah",
    "translation": "Pela tua grande misericórdia..."
  },
  {
    "verse": 5,
    "original": "לְהַגִּיד",
    "transliteration": "lehagiyd",
    "translation": "Para anunciar"
  },
  {
    "verse": 6,
    "original": "כִּי לְאֵל הַגְּבוּרָה",
    "transliteration": "khiy le'el hagevvrah",
    "translation": "Pois para Deus da força"
  },
  {
    "verse": 7,
    "original": "כָּל הַמַּעֲשֶׂה",
    "transliteration": "khal hama'aseh",
    "translation": "Todo o feito"
  },
  {
    "verse": 8,
    "original": "אֲשֶׁר יָצַרְתָּ",
    "transliteration": "'asehr yatsareta",
    "translation": "que formaste"
  },
  {
    "verse": 9,
    "original": "בִּימֵי הַקֶּדֶם",
    "transliteration": "viymey hakedem",
    "translation": "Nos dias antigos"
  },
  {
    "verse": 10,
    "original": "כֻּלָּם לְפָנֶיךָ",
    "transliteration": "khulam lefaneykha",
    "translation": "Todos diante de Ti"
  }
]