[
  {
    "verse": 1,
    "original": "כִּי אֵין עוֹד",
    "transliteration": "khiy 'eyn 'vod",
    "translation": "Pois não há outro."
  },
  {
    "verse": 2,
    "original": "מִבַּלְעָדֶיךָ",
    "transliteration": "mivale'adeykha",
    "translation": "Fora de ti"
  },
  {
    "verse": 3,
    "original": "אֲנִי יָדַעְתִּי",
    "transliteration": "'aniy yada'etiy",
    "translation": "Eu soube"
  },
  {
    "verse": 4,
    "original": "כִּי לָאֵל",
    "transliteration": "khiy la'el",
    "translation": "Pois a Deus"
  },
  {
    "verse": 5,
    "original": "כֹּל צְדָקָה",
    "transliteration": "khol tsedakah",
    "translation": "Toda justiça"
  },
  {
    "verse": 6,
    "original": "בַּיּוֹם הַזֶּה",
