[
  {
    "verse": 1,
    "original": "וּבְהִתְחַזֵּק הַמִּלְחָמָה",
    "transliteration": "vvehitehazek hamilehamah",
    "translation": "E no fortalecimento da guerra..."
  },
  {
    "verse": 2,
    "original": "בְּכֹחַ הַכֹּהֲנִים",
    "transliteration": "vekhoha hakhohaniym",
    "translation": "Pela força dos sacerdotes"
  },
  {
    "verse": 3,
    "original": "בְּקוֹל גָּדוֹל",
    "transliteration": "vekvol gadvol",
    "translation": "Com voz poderosa"
  },
  {
    "verse": 4,
    "original": "יִתְקְעוּ חֲצוֹצְרוֹת",
    "transliteration": "yiteke'v hatsvotservot",
    "translation": "Tocai as trombetas"
  },
  {
    "verse": 5,
    "original": "לְזִכְרוֹן הָאֵל",
    "transliteration": "lezikhervon ha'el",
    "translation": "Para memória de Deus"
  },
  {
    "verse": 6,
    "original": "לְהַחֲרִיד לֵב בְּנֵי חֹשֶׁךְ",
    "transliteration": "lehahariyd lev veney hosehkhe",
    "translation": "fazer tremer o coração dos filhos da escuridão"
  },
  {
    "verse": 7,
    "original": "וּלְחַזֵּק כָּל",
    "transliteration": "vlehazek khal",
    "translation": "e para fortalecer todo"
  },
  {
    "verse": 8,
    "original": "גִּבּוֹרֵי אוֹר",
    "transliteration": "givvorey 'vor",
    "translation": "Guerreiros da luz"
  },
  {
    "verse": 9,
    "original": "בְּאוֹת מִלְחֶמֶת",
    "transliteration": "ve'vot milehemet",
    "translation": "Pela marca da guerra"
  },
  {
    "verse": 10,
    "original": "אֵל",
    "transliteration": "'el",
    "translation": "Deus"
  }
