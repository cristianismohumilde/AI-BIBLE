[
  {
    "verse": 1,
    "original": "כִּי הִנֵּה הִתְאַמְּצוּ",
    "translation": "Pois eis que se fortaleceram"
  },
  {
    "verse": 2,
    "original": "עָלַי עֲרִיצִים",
    "translation": "Sobre mim, opressores..."
  },
  {
    "verse": 3,
    "original": "בָּקְשׁוּ נַפְשִׁי",
