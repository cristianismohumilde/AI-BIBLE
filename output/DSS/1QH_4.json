  },
  {
    "verse": 8,
    "original": "עָמַדְתִּי",
    "translation": "Permaneci..."
  },
  {
    "verse": 9,
    "original": "בַּאֲשֶׁר גָּבְרוּ",
    "translation": "onde se fortaleceram"
