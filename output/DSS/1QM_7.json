[
  {
    "verse": 1,
    "original": "בֶּן עֶשְׂרִים וְחָמֵשׁ",
    "transliteration": "ven 'eseriym vehamesh",
    "translation": "Filho de vinte e cinco"
  },
  {
    "verse": 2,
    "original": "לְהֵחָלֵץ לַמִּלְחָמָה",
    "transliteration": "lehehalets lamilehamah",
    "translation": "para se equipar para a guerra"
  },
  {
    "verse": 3,
    "original": "וְלִרְדֹּת אֶת הַמַּחֲנֶה",
    "transliteration": "veliredot 'et hamahaneh",
    "translation": "e para retirar o acampamento"
  },
  {
    "verse": 4,
    "original": "עֲשֶׂרֶת אֲלָפִים",
    "transliteration": "'aseret 'alafiym",
    "translation": "Dez mil"
  },
  {
    "verse": 5,
    "original": "אַנְשֵׁי הָאָרֶץ",
    "transliteration": "'anesehy ha'arets",
    "translation": "Homens da terra"
  },
  {
    "verse": 6,
    "original": "בְּנֵי חַיִל",
    "transliteration": "veney hayil",
    "translation": "Filhos de valor"
  },
  {
    "verse": 7,
    "original": "לַמִּלְחָמָה",
    "transliteration": "lamilehamah",
    "translation": "Para a guerra"
  },
  {
    "verse": 8,
    "original": "שֶׁבַע שָׁנִים",
    "transliteration": "sehva' sahniym",
    "translation": "sete anos"
  },
  {
    "verse": 9,
    "original": "לְחַמֵּשׁ גְּדוּדוֹת",
    "transliteration": "lehamesh gedvdvot",
    "translation": "Para cinco companhias"
  },
  {
    "verse": 10,
    "original": "תּוֹקְעִים תְּרוּעָה",
    "transliteration": "tvoke'iym terv'ah",
    "translation": "Tocam trombetas em aclamação."
  }
]