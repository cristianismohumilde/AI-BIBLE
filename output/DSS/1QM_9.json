[
  {
    "verse": 1,
    "original": "וּלְעֵת הֶעָרֶב",
    "transliteration": "vle'et he'arev",
    "translation": "E à hora do entardecer"
  },
  {
    "verse": 2,
    "original": "שָׁבוּ הַכֹּהֲנִים",
    "transliteration": "sahvv hakhohaniym",
    "translation": "Voltem-se os sacerdotes"
  },
  {
    "verse": 3,
    "original": "עִם הַלְוִיִּם",
    "transliteration": "'im haleviyim",
    "translation": "Com os levitas"
  },
  {
    "verse": 4,
    "original": "וְהֵם עָמְדוּ בֵּין",
    "transliteration": "vehem 'amedv veyn",
    "translation": "e eles se colocaram entre"
  },
  {
    "verse": 5,
    "original": "הַמַּחֲנֶה הַגָּדוֹל",
    "transliteration": "hamahaneh hagadvol",
    "translation": "O acampamento grande"
  },
  {
    "verse": 6,
    "original": "לְקַדֵּשׁ שֶׁבַע פְּעָמִים",
    "transliteration": "lekadesh sehva' fe'amiym",
    "translation": "Para santificar sete vezes"
  },
  {
    "verse": 7,
    "original": "וְסָבְבוּ הָעִיר",
    "transliteration": "vesavevv ha'iyr",
    "translation": "E cercarão a cidade"
  },
  {
    "verse": 8,
    "original": "בְּקוֹל חֲצוֹצְרוֹת",
    "transliteration": "vekvol hatsvotservot",
    "translation": "Com o som das trombetas"
  },
  {
    "verse": 9,
    "original": "לִגְלוֹת שְׁמַע הַמֶּלֶךְ",
    "transliteration": "ligelvot sehma' hamelekhe",
    "translation": "Para manifestar que se ouviu o rei"
  },
  {
    "verse": 10,
    "original": "וְהַמִּלְחָמָה לְיַד הָאֵל",
    "transliteration": "vehamilehamah leyad ha'el",
    "translation": "E a guerra está na mão de Deus."
  }
]