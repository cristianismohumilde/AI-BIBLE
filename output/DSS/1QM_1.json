  },
  {
    "verse": 3,
    "original": "בַּחֵיל בְּלִיָּעַל",
    "translation": "No exército dos desregrados"
  },
  {
    "verse": 4,
    "original": "כִּתִּיִּים אֱדוֹם וּמוֹאָב",
