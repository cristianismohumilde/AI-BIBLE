[
  {
    "verse": 1,
    "original": "וְאַתָּה אֵל יִשְׂרָאֵל",
    "translation": "E tu, ó Deus de Israel,"
  },
  {
    "verse": 2,
    "original": "לְמַלֵּא יַד בְּנֵי חוֹסֵי",
    "translation": "para encher as mãos dos filhos que esperam"
  },
  {
    "verse": 3,
    "original": "בְּבֵית אֲחִיהֶם",
    "translation": "Na casa de seus irmãos"
  },
  {
    "verse": 4,
    "original": "שָׂם אֱמֶת בִּלְבָבֶךָ",
    "translation": "Pôs em teu coração verdade."
  },
  {
    "verse": 5,
    "original": "וּמִשְׁפָּטִים אֱמֶת",
    "translation": "E juízos de verdade"
  },
  {
    "verse": 6,
    "original": "לְהַצְדִּיק אֶת דָּמֵי בְנֵי אוֹר",
    "translation": "para justificar o sangue dos filhos da luz"
  },
  {
    "verse": 7,
    "original": "בְּנֵי רֹאשׁ בְּנֵי בֶלַע",
    "translation": "Filhos da Cabeça, filhos de Bela..."
  },
  {
    "verse": 8,
    "original": "מָה גָּדוֹל כּוֹחֲךָ",
    "translation": "Quão grande é teu poder"
  },
  {
    "verse": 9,
    "original": "אֱמֶת מוֹשַׁל עוֹלָמִים",
    "translation": "Verdade reina sobre os mundos."
  },
  {
    "verse": 10,
    "original": "אַתָּה לְבַדְּךָ מֶלֶךְ",
    "translation": "Tu, e tu só, és rei."
  }
]