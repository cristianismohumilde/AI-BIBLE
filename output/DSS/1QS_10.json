[
  {
    "verse": 1,
    "original": "יֵשֵׁב בְּמוֹשַׁב רַבִּים",
    "transliteration": "yesehv vemvosahv raviym",
    "translation": "Sentar-se-á no assentamento dos muitos."
  },
  {
    "verse": 2,
    "original": "בְּיַחַד תּוֹרַת אֵל",
    "transliteration": "veyahad tvorat 'el",
    "translation": "Juntamente com a lei de Deus"
  },
  {
    "verse": 3,
    "original": "לְהַנְחִיל כֹּל מַעֲשֵׂה קֹדֶשׁ",
    "transliteration": "lehanehiyl khol ma'aseh kodesh",
    "translation": "para herdar toda obra santa"
  },
  {
    "verse": 4,
    "original": "שְׂפָתַי אֲשַׁבֵּחַ אֱלֹהִים",
    "transliteration": "sefatay 'asahveha 'elohiym",
    "translation": "Minhas lábios louvarão a Deus."
  },
  {
    "verse": 5,
    "original": "בְּצֵאת וּבְבֹוא אֵלֵךְ",
    "transliteration": "vetse't vvevov' 'elekhe",
    "translation": "Na saída e na entrada, caminharei."
  },
  {
    "verse": 6,
    "original": "בְּשֶׁבְתִּי וּבְקוּמִי",
    "transliteration": "vesehvetiy vvekvmiy",
    "translation": "Em minha sentar e em minha levantar,"
  },
  {
    "verse": 7,
    "original": "וּבְשָׁכְבִי עַל מִשְׁכָּבִי",
    "transliteration": "vvesahkheviy 'al misehkhaviy",
    "translation": "E em meu deitar sobre minha cama"
  },
  {
    "verse": 8,
    "original": "אֲרוֹמֵם שְׁמוֹ",
    "transliteration": "'arvomem sehmvo",
    "translation": "Exaltar-ei seu nome."
  },
  {
    "verse": 9,
    "original": "בִּבְרִית יַחַד אֱמֶת",
    "transliteration": "viveriyt yahad 'emet",
    "translation": "Na aliança juntos é verdade."
  },
  {
    "verse": 10,
    "original": "לְכָל מוֹעֲדֵי הַיּוֹם",
    "transliteration": "lekhal mvo'adey hayvom",
    "translation": "Para todos os tempos do dia"
  }
]