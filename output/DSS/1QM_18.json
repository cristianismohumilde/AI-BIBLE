[
  {
    "verse": 1,
    "original": "לַמַּשְׂכִּיל מִזְמוֹר",
    "transliteration": "lamasekhiyl mizemvor",
    "translation": "Ao entendido, um salmo"
  },
  {
    "verse": 2,
    "original": "לְיוֹם הַמִּלְחָמָה",
    "transliteration": "leyvom hamilehamah",
    "translation": "Para o dia da batalha"
  },
  {
    "verse": 3,
    "original": "בָּרוּךְ אֵל הַגָּדוֹל",
    "transliteration": "varvkhe 'el hagadvol",
    "translation": "Bendito seja Deus, o Grande."
  },
  {
    "verse": 4,
    "original": "כִּי לְעוֹלָם חַסְדּוֹ",
    "transliteration": "khiy le'volam hasedvo",
    "translation": "Pois para sempre seu amor durará"
  },
  {
    "verse": 5,
    "original": "כִּי נֶחְשַׁב בְּמִלְחָמָה",
    "transliteration": "khiy nehesahv vemilehamah",
    "translation": "Pois será contado na guerra"
  },
  {
    "verse": 6,
    "original": "וְנִגְלָה כְּבוֹד אֱלֹהֵינוּ",
    "transliteration": "venigelah khevvod 'eloheynv",
    "translation": "E será revelada a glória do nosso Deus."
  },
  {
    "verse": 7,
    "original": "בְּכָל קְצָווֹת הָאָרֶץ",
    "transliteration": "vekhal ketsavvot ha'arets",
    "translation": "Em todas as extremidades da terra"
  },
  {
    "verse": 8,
    "original": "תְּרוּעָה גְדוֹלָה לָאֵל",
    "transliteration": "terv'ah gedvolah la'el",
    "translation": "Rugido grandioso para Deus"
  },
  {
    "verse": 9,
    "original": "בְּחֵיל בְּנֵי אוֹר",
    "transliteration": "veheyl veney 'vor",
    "translation": "Com o exército dos filhos da luz"
  },
  {
    "verse": 10,
    "original": "לְמוֹעֵד נִצָּחוֹן",
    "transliteration": "lemvo'ed nitsahvon",
    "translation": "Para a ocasião da vitória"
  }
]