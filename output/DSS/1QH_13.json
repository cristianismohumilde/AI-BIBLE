[
  {
    "verse": 1,
    "original": "אוֹדְךָ אֲדֹנָי",
    "transliteration": "'vodekha 'adonay",
    "translation": "Te louvo, Senhor."
  },
  {
    "verse": 2,
    "original": "כִּי הָאִרוֹתָ",
    "transliteration": "khiy ha'irvota",
    "translation": "Porque Ele ilumina"
  },
  {
    "verse": 3,
    "original": "פָּנֶיךָ לְעַבְדֶּךָ",
    "transliteration": "faneykha le'avedekha",
    "translation": "Teus rostos para teu servo..."
  },
  {
    "verse": 4,
    "original": "וּפָדִיתָ אוֹתִי",
    "transliteration": "vfadiyta 'votiy",
    "translation": "e livraste-me"
  },
  {
    "verse": 5,
    "original": "מֵאֶרֶץ צִיָּה",
    "transliteration": "me'erets tsiyah",
    "translation": "Da terra seca"
  },
  {
    "verse": 6,
    "original": "מִנַּחַל שְׁאוֹל",
    "transliteration": "minahal seh'vol",
    "translation": "Do rio do Sheol"
  },
  {
    "verse": 7,
    "original": "לְמַרְחֲבֵי חַיִּים",
    "transliteration": "lemarehavey hayiym",
    "translation": "para as amplidões da vida"
  },
  {
    "verse": 8,
    "original": "וּמִפַּח שָׁחַת",
    "transliteration": "vmifah sahhat",
    "translation": "...e da cinza espalha..."
  },
  {
    "verse": 9,
    "original": "הֵרִיחֹתָ נַפְשִׁי",
    "transliteration": "heriyhota nafesihy",
    "translation": "Percebeste minha alma"
  },
  {
    "verse": 10,
    "original": "לִחְיוֹת לְעוֹלָם",
    "transliteration": "liheyvot le'volam",
    "translation": "Viver para sempre"
  }
]