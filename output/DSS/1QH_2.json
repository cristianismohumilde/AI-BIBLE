[
  {
    "verse": 1,
    "original": "בָּרוּךְ אַתָּה אֲדֹנָי",
    "translation": "Bendito és Tu, Senhor."
  },
  {
    "verse": 2,
    "original": "אֵל הַדֵּעוֹת",
    "translation": "Deus dos conhecimentos"
  },
  {
    "verse": 3,
    "original": "אֲשֶׁר בְּחַסְדֶּךָ",
    "translation": "que por teu amor"
  },
  {
    "verse": 4,
    "original": "גְּדוֹל נֶחֱמַדְתִּי",
    "translation": "Muito amado sou"
  },
  {
    "verse": 5,
    "original": "כִּי נוֹדַעְתָּ לִי",
    "translation": "Pois me foste conhecido"
  },
  {
    "verse": 6,
    "original": "סוֹד אֱמֶת",
    "translation": "Segredo da verdade"
  },
  {
    "verse": 7,
    "original": "וּבְדַעְתְּךָ הַנִּפְלָאָה",
    "translation": "E com teu conhecimento maravilhoso"
  },
  {
    "verse": 8,
    "original": "עָשִׂיתָ אֵלֶּה",
    "translation": "Fizeste isso"
  },
  {
    "verse": 9,
    "original": "לְרַחֵם עַל עֲבָדֶיךָ",
    "translation": "Para ter misericórdia sobre teus servos..."
  },
  {
    "verse": 10,
    "original": "הַנִּדְכָּאִים לְפָנֶיךָ",
    "translation": "Os decaídos diante de ti"
  }
]