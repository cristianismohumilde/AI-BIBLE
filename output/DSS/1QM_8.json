[
  {
    "verse": 1,
    "original": "סֵדֶר הַכֹּהֲנִים",
    "translation": "Ordem dos sacerdotes"
  },
  {
    "verse": 2,
    "original": "עוֹמְדִים בֵּין הַמַּעֲרָכוֹת",
    "translation": "...estando entre as fileiras..."
  },
  {
    "verse": 3,
    "original": "חֲגוֹר חֲגוֹרֵי פִשְׁתָּן",
    "translation": "Cinge-te cingidores de linho"
  },
  {
    "verse": 4,
    "original": "כְּתֹנֶת פִּשְׁתָּן פָּתִיל",
    "translation": "Veste de linho tecida"
  },
  {
    "verse": 5,
    "original": "מַחֲגֹרֶת שֵׁשׁ בֹּץ",
    "translation": "Cinto de linho fino..."
  },
  {
    "verse": 6,
    "original": "וְיָפִים עַל הָרֹאשׁ",
    "translation": "E belos sobre a cabeça"
  },
  {
    "verse": 7,
    "original": "מִצְנֶפֶת פִּשְׁתָּן",
    "translation": "Cíclio de linho"
  },
  {
    "verse": 8,
    "original": "לֹא לַעֲלוֹת עִם הַמִּלְחָמָה",
    "translation": "Não subir com os que fazem guerra..."
  },
  {
    "verse": 9,
    "original": "אֶלָּא לְקַדֵּשׁ",
    "translation": "mas para santificar"
  },
  {
    "verse": 10,
    "original": "לַעֲמֹד לִפְנֵי אֵל",
    "translation": "permanecer diante de Deus"
  }
]