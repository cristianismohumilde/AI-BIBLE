[
  {
    "verse": 1,
    "original": "וְכֵן יַעֲשׂוּ לְכָל שָׁנָה וְשָׁנָה",
    "transliteration": "vekhen ya'asv lekhal sahnah vesahnah",
    "translation": "E assim farão de ano em ano."
  },
  {
    "verse": 2,
    "original": "כֹּל הַבָּאִים בִּבְרִית",
    "transliteration": "khol hava'iym viveriyt",
    "translation": "Todos os que vêm à aliança"
  },
  {
    "verse": 3,
    "original": "יָסֹרּוּ לִפְנֵי הַכֹּהֵן הָרֹאשׁ",
    "transliteration": "yasorv lifeney hakhohen haro'sh",
    "translation": "obedecerão perante o sacerdote principal..."
  },
  {
    "verse": 4,
    "original": "וְלִפְנֵי אַנְשֵׁי בְרִיתוֹ",
    "transliteration": "velifeney 'anesehy veriytvo",
    "translation": "E diante dos homens da sua aliança"
  },
  {
    "verse": 5,
    "original": "וְיִשְׂאוּ עַל רֹאשָׁם כָּל תּוֹעֲבֹת",
    "transliteration": "veyise'v 'al ro'sahm khal tvo'avot",
    "translation": "E eles levarão sobre suas cabeças todas as abominações."
  },
  {
    "verse": 6,
    "original": "וְכָל קְלָלוֹת בְּרִית הַתּוֹרָה הַזֹּאת",
    "transliteration": "vekhal kelalvot veriyt hatvorah hazo't",
    "translation": "e todas as maldições do pacto desta lei"
  },
  {
    "verse": 7,
    "original": "וְיִשְׁמְעוּ כָּל הַמִּצְווֹת",
    "transliteration": "veyisehme'v khal hamitsevvot",
    "translation": "E ouvirão todos os mandamentos"
  },
  {
    "verse": 8,
    "original": "אֲשֶׁר יְצַוֵּם לְכָל מַעֲשֵׂה טוֹב",
    "transliteration": "'asehr yetsavem lekhal ma'aseh tvov",
    "translation": "que os ordene a toda obra boa"
  },
  {
    "verse": 9,
    "original": "וְכֵן יַעֲשׂוּ כֵּן יֹאמְרוּ אָמֵן",
    "transliteration": "vekhen ya'asv khen yo'merv 'amen",
    "translation": "E assim farão, assim dirão: Amém."
  },
  {
    "verse": 10,
    "original": "כָּל הַיָּמִים אֲשֶׁר יְהַלְּכוּ בָּהֶם",
    "transliteration": "khal hayamiym 'asehr yehalekhv vahem",
    "translation": "Todos os dias em que andarem neles"
  }
]