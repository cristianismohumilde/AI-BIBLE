[
  {
    "verse": 1,
    "original": "וְאֵלֶּה הֵם דַּרְכֵי הָאֱמֶת בָּעוֹלָם",
    "transliteration": "ve'eleh hem darekhey ha'emet va'volam",
    "translation": "E estes são os caminhos da verdade no mundo."
  },
  {
    "verse": 2,
    "original": "לְהָאִיר לְבָב אָדָם",
    "transliteration": "leha'iyr levav 'adam",
    "translation": "iluminar o coração do homem"
  },
  {
    "verse": 3,
    "original": "וּלְיַשֵּׁר לְפָנָיו כָּל דַּרְכֵי צְדָקַת אֱמֶת",
    "transliteration": "vleyasehr lefanayv khal darekhey tsedakat 'emet",
    "translation": "e endireitar perante Ele todos os caminhos da justiça da verdade"
  },
  {
    "verse": 4,
    "original": "וּלְהָפִיל לֵב אֹיְבָיו",
    "transliteration": "vlehafiyl lev 'oyevayv",
    "translation": "e para lançar o coração dos seus inimigos\n\nA tradução mantém-se fiel ao original em hebraico; no entanto, uma pequena ajuste pode aprimorar a qualidade teológica e formal desejada:\n\ne para prostrarem o coração dos seus inimigos"
  },
  {
    "verse": 5,
    "original": "וְרוּחַ עֲנָוָה וְאֶרֶךְ אַפַּיִם",
    "transliteration": "vervha 'anavah ve'erekhe 'afayim",
    "translation": "E o espírito de mansidão e longanimidade"
  },
  {
    "verse": 6,
    "original": "וְרַב חֲסָדִים וְטוּב עוֹלָמִים",
    "transliteration": "verav hasadiym vetvv 'volamiym",
    "translation": "e rico em misericórdias e bom para todas as gerações"
  },
  {
    "verse": 7,
    "original": "וְשֵׂכֶל וּבִינָה וְחָכְמָה גְּבוּרָה",
    "transliteration": "vesekhel vviynah vehakhemah gevvrah",
    "translation": "e discernimento e entendimento e sabedoria poderosa"
  },
  {
    "verse": 8,
    "original": "וְאֱמוּנָה בְּכָל מַעֲשֵׂי אֵל",
    "transliteration": "ve'emvnah vekhal ma'asey 'el",
    "translation": "E fé em todos os feitos de Deus"
  },
  {
    "verse": 9,
    "original": "וְלֶכֶד חֶסֶד עִם רַחֲמֵי עוֹלָמִים",
    "transliteration": "velekhed hesed 'im rahamey 'volamiym",
    "translation": "E para um laço de misericórdia com compaixões eternas..."
  },
  {
    "verse": 10,
    "original": "וּמִבִּין אֱמֶת דְּעוֹת מִשְׁפָּטֵי קֹדֶשׁ",
    "transliteration": "vmiviyn 'emet de'vot misehfatey kodesh",
    "translation": "E daquele que entende a verdade, conhecendo os juízos santos..."
  },
  {
    "verse": 11,
    "original": "לָלֶכֶת לֹא עָוֶל",
    "transliteration": "lalekhet lo' 'avel",
    "translation": "Não houve perversão ao caminhar."
  },
  {
    "verse": 12,
    "original": "חֲשַׁכִּים וּשְׂנֻאֵי רַשַּׁע",
    "transliteration": "hasahkhiym vsenu'ey rasah'",
    "translation": "...e odientos da maldade"
  },
  {
    "verse": 13,
    "original": "אֵלֶּה הֵם יְסוֹד רוּחַ בְּנֵי אֱמֶת בָּעוֹלָם",
    "transliteration": "'eleh hem yesvod rvha veney 'emet va'volam",
    "translation": "Estes são os fundamentos do espírito dos filhos da verdade no mundo."
  },
  {
    "verse": 14,
    "original": "וּפְקֻדַּת כָּל אֲשֶׁר יִתְהַלֵּךְ בָּהּ",
    "transliteration": "vfekudat khal 'asehr yitehalekhe vah",
    "translation": "E a regra de todo aquele que nela andar"
  }
]