[
  {
    "verse": 1,
    "original": "כִּי הָיָה בַּחֲמָסִים",
    "transliteration": "khiy hayah vahamasiym",
    "translation": "Porque foi entre os violentos"
  },
  {
    "verse": 2,
    "original": "וּבְרֻבֵּי חֶבְלֵי מָוֶת",
    "transliteration": "vveruvey heveley mavet",
    "translation": "E nos muitos laços da morte"
  },
  {
    "verse": 3,
    "original": "מַלְכוֹדוֹת שָׁאוֹל",
    "transliteration": "malekhvodvot sah'vol",
    "translation": "Domínios do Abismo"
  },
  {
    "verse": 4,
    "original": "עַד מִתַּחַת",
    "transliteration": "'ad mitahat",
    "translation": "Até debaixo"
  },
  {
    "verse": 5,
    "original": "מְקוֹם הַיִּסּוּרִים",
    "transliteration": "mekvom hayisvriym",
    "translation": "Lugar dos sofrimentos"
  },
  {
    "verse": 6,
    "original": "וּמֵאַחַר הָיִיתִי",
    "transliteration": "vme'ahar hayiytiy",
    "translation": "E depois fui"
  },
  {
    "verse": 7,
    "original": "בְּשִׁיר אוֹדֶה",
    "transliteration": "vesihyr 'vodeh",
    "translation": "No canto, eu dou graças"
  },
  {
    "verse": 8,
    "original": "לְשִׁמְךָ",
    "transliteration": "lesihmekha",
    "translation": "Para teu nome"
  },
  {
    "verse": 9,
    "original": "כִּי הִגְדַּלְתָּ",
    "transliteration": "khiy higedaleta",
    "translation": "Pois tu exaltaste"
  },
  {
    "verse": 10,
    "original": "חֶסְדְּךָ עָלַי",
    "transliteration": "hesedekha 'alay",
    "translation": "Teu amor está sobre mim."
  }
]