[
  {
    "verse": 1,
    "original": "כִּי בְּחַסְדְּךָ",
    "translation": "Pois em teu amor"
  },
  {
    "verse": 2,
    "original": "הִגְדַּלְתָּ עָלַי",
    "translation": "Exaltaste-te sobre mim"
  },
  {
    "verse": 3,
    "original": "לְהַבְדִּיל אוֹתִי",
    "translation": "para me separar"
  },
  {
    "verse": 4,
    "original": "מִן הַהֲמוֹן",
    "translation": "Do ruído"
  },
  {
    "verse": 5,
    "original": "וּלְקָרְבֵנִי",
    "translation": "e para me aproximar"
  },
  {
    "verse": 6,
    "original": "לִפְנֵי כִסְאֶךָ",
    "translation": "Diante de teu trono"
  },
  {
    "verse": 7,
    "original": "וּלְהַשְׂכִּילֵנִי",
    "translation": "e para me dar discernimento"
  },
  {
    "verse": 8,
    "original": "בְּסוֹד קֹדֶשׁ",
    "translation": "No segredo santo"
  },
  {
    "verse": 9,
    "original": "בְּכָל מִשְׁמֶרֶת יָד",
    "translation": "Em toda vigília da mão"
  },
  {
    "verse": 10,
    "original": "תּוֹרָתֶךָ",
    "translation": "Tua lei"
  }
]