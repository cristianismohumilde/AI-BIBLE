[
  {
    "verse": 1,
    "original": "בְּיוֹם הַקְּרָב",
    "translation": "No dia da batalha"
  },
  {
    "verse": 2,
    "original": "עִם מַלְכוּת כִּתִּיִּים",
    "translation": "com o reino dos gregos"
  },
  {
    "verse": 3,
    "original": "יֵצְאוּ לַמִּלְחָמָה",
    "translation": "Saíam para a guerra"
  },
  {
    "verse": 4,
    "original": "כֹּהֵן גָּדוֹל",
    "translation": "Sacerdote Sumo"
  },
  {
    "verse": 5,
    "original": "וּמִשְׁנֵהוּ",
    "translation": "e sua segunda parte"
  },
  {
    "verse": 6,
    "original": "וּשְׁלִישָׁם",
    "translation": "E sua terça parte..."
  },
  {
    "verse": 7,
    "original": "לְחַזֵּק יְדֵי הַמִּלְחָמָה",
    "translation": "Para fortalecer as mãos para a guerra"
  },
  {
    "verse": 8,
    "original": "וּלְבָרֵךְ אֶת הָאֵל",
    "translation": "e para abençoar o Deus"
  },
  {
    "verse": 9,
    "original": "לְפַחַד אֶת הָאוֹיֵב",
    "translation": "Por temor ao inimigo"
  },
  {
    "verse": 10,
    "original": "לְחַדֵּד לֵב הַחֲלָלִים",
    "translation": "para afiar o coração dos mortos"
  }
]