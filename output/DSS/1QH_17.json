[
  {
    "verse": 1,
    "original": "אוֹדְךָ אֲדֹנָי",
    "translation": "Te louvarei, Senhor."
  },
  {
    "verse": 2,
    "original": "כִּי עֵינְךָ עָמְדָה לִי",
    "translation": "Porque teu olhar permaneceu sobre mim."
  },
  {
    "verse": 3,
    "original": "בְּעֵת מְצוּקָה",
    "translation": "No tempo da angústia"
  },
  {
    "verse": 4,
    "original": "לֹא עֲזַבְתַּנִי",
    "translation": "Não me deixaste."
  },
  {
    "verse": 5,
    "original": "בְּפֶשַׁע כָּל",
    "translation": "pelo pecado de todos"
  },
  {
    "verse": 6,
    "original": "וְלֹא הִסְתַּרְתָּ",
    "translation": "e não te escondeste"
  },
  {
    "verse": 7,
    "original": "פָּנֶיךָ מִמֶּנִּי",
    "translation": "Teu rosto de mim..."
  },
  {
    "verse": 8,
    "original": "בְּעֵת עִוַּת",
    "translation": "...tempo de angústia..."
  },
  {
    "verse": 9,
    "original": "אֶל תְּחִנָּתִי",
    "translation": "À minha súplica"
  },
  {
    "verse": 10,
    "original": "הִקְשַׁבְתָּ",
    "translation": "Escutaste"
  }
]