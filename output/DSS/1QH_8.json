[
  {
    "verse": 1,
    "original": "מִי כָמוֹךָ",
    "transliteration": "miy khamvokha",
    "translation": "Quem como ti?"
  },
  {
    "verse": 2,
    "original": "בֵּין כָּל רוּחֵי דַּעַת",
    "transliteration": "veyn khal rvhey da'at",
    "translation": "Entre todos os espíritos de conhecimento..."
  },
  {
    "verse": 3,
    "original": "אֵל הַדֵּעוֹת",
    "transliteration": "'el hade'vot",
    "translation": "Deus dos conhecimentos"
  },
  {
    "verse": 4,
    "original": "כֹּל הוֹד וְהָדָר",
    "transliteration": "khol hvod vehadar",
    "translation": "Toda glória e esplendor"
  },
  {
    "verse": 5,
    "original": "גְּבוּרָה וָעֹז",
    "transliteration": "gevvrah va'oz",
    "translation": "Poder e força"
  },
  {
    "verse": 6,
    "original": "כִּי אַתָּה הוּא",
    "transliteration": "khiy 'atah hv'",
    "translation": "Pois tu és aquele"
  },
  {
    "verse": 7,
    "original": "בִּמְרוֹמֵי שָׁמַיִם",
    "transliteration": "vimervomey sahmayim",
    "translation": "Nos exaltados céus"
  },
  {
    "verse": 8,
    "original": "מוֹשַׁב קֹדֶשׁ",
    "transliteration": "mvosahv kodesh",
    "translation": "Lugar de santidade"
  },
  {
    "verse": 9,
    "original": "לִפְנֵי הֲמוֹן קְדוֹשִׁים",
    "transliteration": "lifeney hamvon kedvosihym",
    "translation": "Diante da multidão dos santos..."
  },
  {
    "verse": 10,
    "original": "עֹמֵד לְפָנֶיךָ",
    "transliteration": "'omed lefaneykha",
    "translation": "Está de pé diante de ti"
  }
]