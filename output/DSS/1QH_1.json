[
  {
    "verse": 1,
    "original": "אוֹדְךָ אֲדֹנָי",
    "transliteration": "'vodekha 'adonay",
    "translation": "Te louvo, Senhor."
  },
  {
    "verse": 2,
    "original": "כִּי שַׂמְתָּ נַפְשִׁי",
    "transliteration": "khiy sameta nafesihy",
    "translation": "Porque puseste minha alma"
  },
  {
    "verse": 3,
    "original": "בִּצְרוֹר הַחַיִּים",
    "transliteration": "vitservor hahayiym",
    "translation": "No cerne da vida"
  },
  {
    "verse": 4,
    "original": "וְתִגְדְּרֵנִי מִכָּל פַּחֵי שָׁחַת",
    "transliteration": "vetigedereniy mikhal fahey sahhat",
    "translation": "E me guardará de todos os laços da cova."
  },
  {
    "verse": 5,
    "original": "וְאַנְשֵׁי חָמָס",
    "transliteration": "ve'anesehy hamas",
    "translation": "E os homens da violência"
  },
  {
    "verse": 6,
    "original": "לֹא יִשְׁלְטוּ בִּי",
    "transliteration": "lo' yisehletv viy",
    "translation": "Não me dominarão"
  },
  {
    "verse": 7,
    "original": "בְּקוֹמְמָם עָלַי",
    "transliteration": "vekvomemam 'alay",
    "translation": "Ao se erguerem contra mim"
  },
  {
    "verse": 8,
    "original": "כִּי שָׁמַרְתָּ נַפְשִׁי",
    "transliteration": "khiy sahmareta nafesihy",
    "translation": "Porque guardaste minha alma"
  },
  {
    "verse": 9,
    "original": "וּמֵעָוֶל צִוִּיתַנִי",
    "transliteration": "vme'avel tsiviytaniy",
    "translation": "E do pecado me distanteaste"
  },
  {
    "verse": 10,
    "original": "לְכַפֵּר בִּפְשָׁעֵי הָרַבִּים",
    "transliteration": "lekhafer vifesah'ey haraviym",
    "translation": "para expiar pelos pecados da multidão"
  }
]