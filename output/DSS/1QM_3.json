[
  {
    "verse": 1,
    "original": "דֶּגֶל כָּל הָעֵדָה",
    "transliteration": "degel khal ha'edah",
    "translation": "Estandarte de toda a congregação"
  },
  {
    "verse": 2,
    "original": "כָּתוּב שֵׁם יִשְׂרָאֵל",
    "transliteration": "khatvv sehm yisera'el",
    "translation": "O nome de Israel está escrito."
  },
  {
    "verse": 3,
    "original": "שֵׁם אַהֲרוֹן שְׁמוֹת שְׁנֵים עָשָׂר",
    "transliteration": "sehm 'aharvon sehmvot sehneym 'asar",
    "translation": "O nome de Arão, seus doze nomes."
  },
  {
    "verse": 4,
    "original": "שִׁבְטֵי יִשְׂרָאֵל",
    "transliteration": "sihvetey yisera'el",
    "translation": "Varões de Israel\n\nDeve ser corrigido para:\n\nTribos de Israel"
  },
  {
    "verse": 5,
    "original": "לְפִי סִדְרָם",
    "transliteration": "lefiy sideram",
    "translation": "Segundo seu ordenamento"
  },
  {
    "verse": 6,
    "original": "עַל הַדֶּגֶל הַגָּדוֹל",
    "transliteration": "'al hadegel hagadvol",
    "translation": "Sobre a bandeira grande"
  },
  {
    "verse": 7,
    "original": "מִשְׁמָאלוֹ וּמִיְּמִינוֹ",
    "transliteration": "misehma'lvo vmiyemiynvo",
    "translation": "De sua esquerda e de sua direita."
  },
  {
    "verse": 8,
    "original": "שְׁמוֹת שְׁלֹשׁ מֵאוֹת",
    "transliteration": "sehmvot sehlosh me'vot",
    "translation": "Nomes de trezentos"
  },
  {
    "verse": 9,
    "original": "וּנְשִׂיאֵי הָרֹאשִׁים",
    "transliteration": "vnesiy'ey haro'sihym",
    "translation": "e os príncipes das cabeças"
  },
  {
    "verse": 10,
    "original": "כָּתוּב אֵל יִשְׂרָאֵל",
    "transliteration": "khatvv 'el yisera'el",
    "translation": "É escrito a Israel"
  }
]