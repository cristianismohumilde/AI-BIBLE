[
  {
    "verse": 1,
    "original": "אוֹדְךָ אֲדֹנָי",
    "transliteration": "'vodekha 'adonay",
    "translation": "Te louvo, Senhor."
  },
  {
    "verse": 2,
    "original": "כִּי עֵינֶיךָ עַל נַפְשִׁי",
    "transliteration": "khiy 'eyneykha 'al nafesihy",
    "translation": "Porque teus olhos estão sobre minha alma."
  },
  {
    "verse": 3,
    "original": "וְחָלַצְתָּ אֶת נֶפֶשׁ אֶבְיוֹן",
    "transliteration": "vehalatseta 'et nefesh 'eveyvon",
    "translation": "E tu despojarás a alma do pobre."
  },
  {
    "verse": 4,
    "original": "מֵעֵצַת מְרָרִים",
    "transliteration": "me'etsat merariym",
    "translation": "Do conselho dos amargos"
  },
  {
    "verse": 5,
    "original": "וְנֶפֶשׁ אֶבְיוֹן",
    "transliteration": "venefesh 'eveyvon",
    "translation": "e a alma do pobre"
  },
  {
    "verse": 6,
    "original": "הִצַּלְתָּ מֵאַנְשֵׁי חָמָס",
    "transliteration": "hitsaleta me'anesehy hamas",
    "translation": "Livriste dos homens violentos\n\nCorreção:\nLiberaste dos homens violentos"
  },
  {
    "verse": 7,
    "original": "וְלֹא שָׁכַחְתָּ נַפְשִׁי",
    "transliteration": "velo' sahkhaheta nafesihy",
    "translation": "E não esqueceste minha alma"
  },
  {
    "verse": 8,
    "original": "בְּצוֹרֵר יְרִיבַי",
    "transliteration": "vetsvorer yeriyvay",
    "translation": "No opróbrio dos meus adversários"
  },
  {
    "verse": 9,
    "original": "מִיַּד בְּנֵי עַוְלָה",
    "transliteration": "miyad veney 'avelah",
    "translation": "Da mão dos filhos da iniquidade"
  },
  {
    "verse": 10,
    "original": "לְמַעַן שִׂמְחַת לִבִּי",
    "transliteration": "lema'an simehat liviy",
    "translation": "Para alegria do meu coração"
  }
]