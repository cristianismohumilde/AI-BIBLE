[
  {
    "verse": 1,
    "original": "וּבְמוֹשַׁב הָרַבִּים יֵשְׁבוּ שְׁנֵים עָשָׂר אִישׁ",
    "transliteration": "vvemvosahv haraviym yesehvv sehneym 'asar 'iysh",
    "translation": "E no assentamento dos muitos, sentar-se-ão doze homens."
  },
  {
    "verse": 2,
    "original": "וּשְׁלֹשָׁה כֹהֲנִים תְּמִימֵי דֶּרֶךְ",
    "transliteration": "vsehlosahh khohaniym temiymey derekhe",
    "translation": "E três sacerdotes integros de caminho"
  },
  {
    "verse": 3,
    "original": "בְּכֹל הַנִּגְלֶה מִן הַתּוֹרָה",
    "transliteration": "vekhol hanigeleh min hatvorah",
    "translation": "Em toda a revelação da Torá"
  },
  {
    "verse": 4,
    "original": "לַעֲשׂוֹת אֱמֶת צֶדֶק וּמִשְׁפָּט",
    "transliteration": "la'asvot 'emet tsedek vmisehfat",
    "translation": "Fazer a verdade, justiça e juízo."
  },
  {
    "verse": 5,
    "original": "אַהֲבַת חֶסֶד עֲנָוָה לְכָל אִישׁ",
    "transliteration": "'ahavat hesed 'anavah lekhal 'iysh",
    "translation": "Amor de misericórdia, humildade para todo homem..."
  },
  {
    "verse": 6,
    "original": "לַשְׁמֹר אֱמוּנָה בָּאָרֶץ",
    "transliteration": "lasehmor 'emvnah va'arets",
    "translation": "Cuidar da fé na terra..."
  },
  {
    "verse": 7,
    "original": "בְּמַעְרֶבֶת חֶסֶד וְעֲנָוָה",
    "transliteration": "vema'erevet hesed ve'anavah",
    "translation": "Na sombra da bondade e humildade..."
  },
  {
    "verse": 8,
    "original": "לְכַפֵּר בַּעֲד אַשְׁמָה",
    "transliteration": "lekhafer va'ad 'asehmah",
    "translation": "para expiar pela transgressão"
  },
  {
    "verse": 9,
    "original": "בַּעֲשׂוֹת מִשְׁפָּט וּמְצוּקָה",
    "transliteration": "va'asvot misehfat vmetsvkah",
    "translation": "Na prática do juízo e da aflição..."
  },
  {
    "verse": 10,
    "original": "וְלַהֲלֹוךְ עִם כָּל אִישׁ",
    "transliteration": "velahalovkhe 'im khal 'iysh",
    "translation": "e para andar com todo homem"
  },
  {
    "verse": 11,
    "original": "בְּמִדַּת אֱמֶת וּבְתִקּוּן הַדֶּרֶךְ",
    "transliteration": "vemidat 'emet vvetikvn haderekhe",
    "translation": "Na medida da verdade e na correção do caminho..."
  }
]