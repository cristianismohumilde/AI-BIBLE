    "translation": "E depois irão..."
  },
  {
    "verse": 2,
    "original": "בֵּית הַמִּדְרָשׁ",
    "transliteration": "veyt hamiderash",
    "translation": "Casa da Instrução"
  },
  {
    "verse": 3,
    "original": "לְשַׁלֵּם נֶדֶר",
    "transliteration": "lesahlem neder",
    "translation": "Para cumprir o voto"
  },
  {
    "verse": 4,
    "original": "וְלִנְסֹךְ נְסָכִים",
    "transliteration": "velinesokhe nesakhiym",
    "translation": "e para oferecer libações"
  },
  {
    "verse": 5,
    "original": "לִפְנֵי אֵל",
    "transliteration": "lifeney 'el",
    "translation": "Diante de Deus"
  },
  {
    "verse": 6,
    "original": "וּלְהַרִים תְּרוּמָה",
    "transliteration": "vlehariym tervmah",
    "translation": null
  },
  {
    "verse": 7,
    "original": "לְכֹהֵן הַגָּדוֹל",
    "transliteration": "lekhohen hagadvol",
    "translation": "Ao sacerdote supremo"
  },
  {
    "verse": 8,
    "original": "וְאַחֲרָיו שָׁשׁ פְּעָמִים",
    "transliteration": "ve'aharayv sahsh fe'amiym",
    "translation": "E após ele, Shash fará saltos."
  },
  {
    "verse": 9,
    "original": "שָׁלוֹם לְיִשְׂרָאֵל",
    "transliteration": "sahlvom leyisera'el",
    "translation": "Paz a Israel"
  },
  {
    "verse": 10,
    "original": "כִּי בָּא הַנְּצָחוֹן",
