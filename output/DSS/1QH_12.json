[
  {
    "verse": 1,
    "original": "מָה אֲנִי",
    "translation": "Quem sou eu?"
  },
  {
    "verse": 2,
    "original": "כִּי הִגְדַּלְתָּ שְׁמִי",
    "translation": "Pois engrandeceste meu nome."
  },
  {
    "verse": 3,
    "original": "עֲלֵיהֶם",
    "translation": "Sobre eles"
  },
  {
    "verse": 4,
    "original": "כִּי לֹא בְחַסְדִּי",
    "translation": "Pois não por minha misericórdia"
  },
  {
    "verse": 5,
    "original": "אֶלָּא בְחַסְדֶּךָ",
    "translation": "Senão, em teu amor"
  },
  {
    "verse": 6,
    "original": "הִגְדַּלְתֶּנִי",
    "translation": "Exaltaste-me"
  },
  {
    "verse": 7,
    "original": "הֲיוּכַל עָפָר",
    "translation": "Será que pó poderia..."
  },
  {
    "verse": 8,
    "original": "לְהַגִּיד",
    "translation": "para anunciar"
  },
  {
    "verse": 9,
    "original": "גְּבוּרָתֶךָ",
    "translation": "Teu poder"
  },
  {
    "verse": 10,
    "original": "אֲדֹנָי",
    "translation": "Senhor"
  }
]