[
  {
    "verse": 1,
    "original": "בְּשַׂמֵּחַ לְבַב",
    "translation": "Com alegrar o coração..."
  },
  {
    "verse": 2,
    "original": "כָּל מִתְרַצִּים",
    "translation": "Todos os que se justificam"
  },
  {
    "verse": 3,
    "original": "לִשְׁמוֹ",
    "translation": "para Seu nome"
  },
  {
    "verse": 4,
    "original": "וְהוֹדִיעֵנוּ",
    "translation": "e nos faça conhecer"
  },
  {
    "verse": 5,
    "original": "מַעֲשֵׂי גְדֻלָּתוֹ",
    "translation": "Obras de sua grandeza"
  },
  {
    "verse": 6,
    "original": "וְלָנוּ",
    "translation": "E para nós"
  },
  {
    "verse": 7,
    "original": "אַל תִּתְנֵנוּ",
    "translation": "Não nos entregues"
  },
  {
    "verse": 8,
    "original": "בְּיַד",
    "translation": "Na mão"
  },
  {
    "verse": 9,
    "original": "עַם זָר",
    "translation": "Povo estranho"
  },
  {
    "verse": 10,
    "original": "לָנֶצַח",
    "translation": "Para sempre"
  }
]