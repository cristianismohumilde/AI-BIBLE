[
  {
    "verse": 1,
    "original": "בְּשַׂמֵּחַ לְבַב",
    "transliteration": "vesameha levav",
    "translation": "Com alegrar o coração..."
  },
  {
    "verse": 2,
    "original": "כָּל מִתְרַצִּים",
    "transliteration": "khal miteratsiym",
    "translation": "Todos os que se justificam"
  },
  {
    "verse": 3,
    "original": "לִשְׁמוֹ",
    "transliteration": "lisehmvo",
    "translation": "para Seu nome"
  },
  {
    "verse": 4,
    "original": "וְהוֹדִיעֵנוּ",
    "transliteration": "vehvodiy'env",
    "translation": "e nos faça conhecer"
  },
  {
    "verse": 5,
    "original": "מַעֲשֵׂי גְדֻלָּתוֹ",
    "transliteration": "ma'asey gedulatvo",
    "translation": "Obras de sua grandeza"
  },
  {
    "verse": 6,
    "original": "וְלָנוּ",
    "transliteration": "velanv",
    "translation": "E para nós"
  },
  {
    "verse": 7,
    "original": "אַל תִּתְנֵנוּ",
    "transliteration": "'al titenenv",
    "translation": "Não nos entregues"
  },
  {
    "verse": 8,
    "original": "בְּיַד",
    "transliteration": "veyad",
    "translation": "Na mão"
  },
  {
    "verse": 9,
    "original": "עַם זָר",
    "transliteration": "'am zar",
    "translation": "Povo estranho"
  },
  {
    "verse": 10,
    "original": "לָנֶצַח",
    "transliteration": "lanetsah",
    "translation": "Para sempre"
  }
]