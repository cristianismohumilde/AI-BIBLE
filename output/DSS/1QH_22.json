[
  {
    "verse": 1,
    "original": "אֲנִי יָדַעְתִּי",
    "translation": "Eu soube"
  },
  {
    "verse": 2,
    "original": "בְּרֹב חֶסֶד",
    "translation": "Pela abundância do teu amor"
  },
  {
    "verse": 3,
    "original": "עֲנִיתָנִי",
    "translation": "Me atormentaste"
  },
  {
    "verse": 4,
    "original": "לְמַעַן",
    "translation": "para que"
  },
  {
    "verse": 5,
    "original": "אֱמֶת שִׁמְךָ",
    "translation": "Verdadeiro é teu nome"
  },
  {
    "verse": 6,
    "original": "וּבְכָל",
    "translation": "e em tudo"
  },
  {
    "verse": 7,
    "original": "לְבָבִי",
