[
  {
    "verse": 1,
    "original": "וַאֲנִי עֹפָר וָאֵפֶר",
    "transliteration": "va'aniy 'ofar va'efer",
    "translation": "E eu sou pó e cinza"
  },
  {
    "verse": 2,
    "original": "מָה אֶחְשֹׁב",
    "transliteration": "mah 'ehesohv",
    "translation": "Que poderei pensar?"
  },
  {
    "verse": 3,
    "original": "בְּלִי רָצֹון",
    "transliteration": "veliy ratsovn",
    "translation": "Sem vontade"
  },
  {
    "verse": 4,
    "original": "לֹא אָכֹל",
    "transliteration": "lo' 'akhol",
    "translation": "Não comer."
  },
  {
    "verse": 5,
    "original": "עַד הֵכַנְתָּ",
    "transliteration": "'ad hekhaneta",
    "translation": "Até quando me houveres conhecido"
  },
  {
    "verse": 6,
    "original": "פִּי לְמַעֲנֶיךָ",
    "transliteration": "fiy lema'aneykha",
    "translation": "Boca por tua causa..."
  },
  {
    "verse": 7,
    "original": "לְמַעַן שִׁמְךָ",
    "transliteration": "lema'an sihmekha",
    "translation": "Para teu nome"
  },
  {
    "verse": 8,
    "original": "לְמֶלֶךְ הָאֱמֶת",
    "transliteration": "lemelekhe ha'emet",
    "translation": "Ao Rei da Verdade"
  },
  {
    "verse": 9,
    "original": "כִּי אַתָּה הָאֵל",
    "transliteration": "khiy 'atah ha'el",
    "translation": "Pois tu és o Deus"
  },
  {
    "verse": 10,
    "original": "וּמֵאִתְּךָ כֹּל",
    "transliteration": "vme'itekha khol",
    "translation": "E de ti tudo..."
  }
]