[
  {
    "verse": 1,
    "original": "תּוֹדוֹת לְאֵל",
    "translation": "Louvores a Deus"
  },
  {
    "verse": 2,
    "original": "הַמְקַיֵּם",
    "translation": "O que sustenta"
  },
  {
    "verse": 3,
    "original": "חֶסֶד לִבְרִיתוֹ",
    "translation": "fé em sua aliança"
  },
  {
    "verse": 4,
    "original": "מְגַמַּת נֶפֶשׁ",
    "translation": "Desejo da alma"
  },
  {
    "verse": 5,
    "original": "לְדָרְשׁוֹ",
    "translation": "Para buscá-lo"
  },
  {
    "verse": 6,
    "original": "כָּל הַיָּמִים",
    "translation": "Todos os dias"
  },
  {
    "verse": 7,
    "original": "וּלְהוֹדוֹת",
    "translation": "e para louvar"
  },
  {
    "verse": 8,
    "original": "לִשְׁמוֹ בְּפִי",
    "translation": "Por sua glória na minha boca"
  },
  {
    "verse": 9,
    "original": "כָּל בְּרִיּוֹתָיו",
    "translation": "Todas as suas criaturas"
  },
  {
    "verse": 10,
    "original": "לְעוֹלַם וָעֶד",
    "translation": "Para sempre e eternamente"
  }
]