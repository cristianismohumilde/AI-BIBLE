[
  {
    "verse": 1,
    "original": "כְּבוֹא הַדָּבָר הַזֶּה לְיִשְׂרָאֵל",
    "transliteration": "khevvo' hadavar hazeh leyisera'el",
    "translation": "Ao vir esta palavra a Israel..."
  },
  {
    "verse": 2,
    "original": "לְמוֹסַד קֹדֶשׁ לְאַהֲרוֹן",
    "transliteration": "lemvosad kodesh le'aharvon",
    "translation": "Para a instituição santa de Arão..."
  },
  {
    "verse": 3,
    "original": "לְיַחַד קֹדֶשׁ קֳדָשִׁים",
    "transliteration": "leyahad kodesh kodasihym",
    "translation": "Para junto santuário dos santos"
  },
  {
    "verse": 4,
    "original": "וּלְבֵית הָאֱמֶת בְּיִשְׂרָאֵל",
    "transliteration": "vleveyt ha'emet veyisera'el",
    "translation": "e à casa da verdade em Israel"
  },
  {
    "verse": 5,
    "original": "הַהֹלְכִים בְּתָמִים",
    "transliteration": "haholekhiym vetamiym",
    "translation": "Os que andam na perfeição"
  },
  {
    "verse": 6,
    "original": "אַל יִשְׁתַּמֵּשׁ בְּהוֹן הָאַנְשֵׁי הַעֲוֶל",
    "transliteration": "'al yisehtamesh vehvon ha'anesehy ha'avel",
    "translation": "Não sejam tocados por eles, ó homens de iniquidade."
  },
  {
    "verse": 7,
    "original": "אֲשֶׁר לֹא הֵסִירוּ מֵעָלָיו עֹל פֶּשַׁע",
    "transliteration": "'asehr lo' hesiyrv me'alayv 'ol fesah'",
    "translation": "que não removeram de cima dele o fardo do pecado"
  },
  {
    "verse": 8,
    "original": "אֵלֶּה יִהְיוּ לְמִשְׁפַּט יַחַד",
    "transliteration": "'eleh yiheyv lemisehfat yahad",
    "translation": "Estes serão julgados juntamente."
  },
  {
    "verse": 9,
    "original": "לַכַּפֵּר בַּעֲד כָּל חַטֹּאת",
    "transliteration": "lakhafer va'ad khal hato't",
    "translation": "para fazer expiação por todos os pecados"
  },
  {
    "verse": 10,
    "original": "וְלָקֵץ כָּל חֶסֶד לְפָנָיו",
    "transliteration": "velakets khal hesed lefanayv",
    "translation": "e selecionará toda a misericórdia diante dele"
  }
]