[
  {
    "verse": 1,
    "original": "כִּי אַתָּה גִּלִּיתָ",
    "transliteration": "khiy 'atah giliyta",
    "translation": "Porque tu descobriste"
  },
  {
    "verse": 2,
    "original": "אָזְנֵי עֲבָדֶיךָ",
    "transliteration": "'azeney 'avadeykha",
    "translation": "Ouvidos dos teus servos"
  },
  {
    "verse": 3,
    "original": "לְסוֹד רוּחוֹת",
    "transliteration": "lesvod rvhvot",
    "translation": "Para o segredo dos espíritos"
  },
  {
    "verse": 4,
    "original": "לְהַגִּיד אֱמֶת",
    "transliteration": "lehagiyd 'emet",
    "translation": "Proclamar a verdade..."
  },
  {
    "verse": 5,
    "original": "לְבַיֵּשׁ אֲנָשִׁים",
    "transliteration": "levayesh 'anasihym",
    "translation": "Para envergonhar os homens"
  },
  {
    "verse": 6,
    "original": "כִּי אַתָּה אֱמֶת",
    "transliteration": "khiy 'atah 'emet",
    "translation": "Pois tu és a verdade."
  },
  {
    "verse": 7,
    "original": "וּבְיָדְךָ מִשְׁפָּט",
    "transliteration": "vveyadekha misehfat",
    "translation": "E em tua mão está o juízo..."
  },
  {
    "verse": 8,
    "original": "לְהַשְׁכִּיל לֵב",
    "transliteration": "lehasehkhiyl lev",
    "translation": "Para esclarecer o coração"
  },
  {
    "verse": 9,
    "original": "בְּכָל",
    "transliteration": "vekhal",
    "translation": "em todos"
  },
  {
    "verse": 10,
    "original": "נַפְשׁוֹת בְּשָׂרֶיךָ",
    "transliteration": "nafeshvot vesareykha",
    "translation": "Almas de tuas carnes"
  }
]