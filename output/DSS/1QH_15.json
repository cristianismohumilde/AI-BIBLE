[
  {
    "verse": 1,
    "original": "בְּתוֹסֶפֶת חֶסֶד",
    "transliteration": "vetvosefet hesed",
    "translation": "Complemento da misericórdia"
  },
  {
    "verse": 2,
    "original": "לְמַעַן גְּאֻלַּת",
    "transliteration": "lema'an ge'ulat",
    "translation": "para a redenção"
  },
  {
    "verse": 3,
    "original": "כָּל נֶאֱסָף",
    "transliteration": "khal ne'esaf",
    "translation": "Todo reunido está"
  },
  {
    "verse": 4,
    "original": "כִּי כוֹן בִּקַּשְׁתִּי",
    "transliteration": "khiy khvon vikasehtiy",
    "translation": "Porque firme fiz minha petição..."
  },
  {
    "verse": 5,
    "original": "בִּדְעַת אֱמֶת",
    "transliteration": "vide'at 'emet",
    "translation": "Pelo conhecimento da verdade"
  },
  {
    "verse": 6,
    "original": "לְחַזֵּק לֵב",
    "transliteration": "lehazek lev",
    "translation": "Para fortalecer o coração..."
  },
  {
    "verse": 7,
    "original": "כָּל בְּנֵי אוֹר",
    "transliteration": "khal veney 'vor",
    "translation": "Todos os filhos da luz"
  },
  {
    "verse": 8,
    "original": "לְרַחֵם עַל נֶפֶשׁ",
    "transliteration": "lerahem 'al nefesh",
    "translation": "para ter misericórdia da alma"
  },
  {
    "verse": 9,
    "original": "נִדְכָּה",
    "transliteration": "nidekhah",
    "translation": "Derrotada..."
  },
  {
    "verse": 10,
    "original": "לִדְרֹשׁ אֵל",
    "transliteration": "liderosh 'el",
    "translation": "Para buscar a Deus"
  }
]