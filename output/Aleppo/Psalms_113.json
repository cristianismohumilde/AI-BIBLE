  {
    "verse": 6,
    "original": "<span data-strong=\"H8213\">הַֽמַּשְׁפִּילִ֥י</span> <span data-strong=\"H7200\">לִרְא֑וֹת</span> <span data-strong=\"H8064\">בַּשָּׁמַ֥יִם</span> <span data-strong=\"H776\">וּבָאָֽרֶץ׃</span>",
