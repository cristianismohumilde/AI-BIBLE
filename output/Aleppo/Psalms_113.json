  {
    "verse": 5,
    "original": "<span data-strong=\"H4310\">מִ֭י</span> <span data-strong=\"H3068\">כַּיהֹוָ֣ה</span> <span data-strong=\"H5105\">אֱלֹהֵ֑ינוּ</span> <span data-strong=\"H1361\">הַֽמַּגְבִּיהִ֥י</span> <span data-strong=\"H3427\">לָשָֽׁבֶת׃</span>",
