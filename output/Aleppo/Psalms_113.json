[
  {
    "verse": 1,
    "original": "הַ֥לְלוּ<span class=\"mam-implicit-maqaf\">־</span>יָ֨הּ&thinsp;<b>׀</b> הַ֭לְלוּ עַבְדֵ֣י יְהֹוָ֑ה הַֽ֝לְל֗וּ אֶת־שֵׁ֥ם יְהֹוָֽה׃",
    "transliteration": "halelv<span class=\"mam-implicit-maqaf\">-</span>yah&thinsp;<b>|</b> halelv 'avedey yehovah halelv 'et-shem yehovah.",
    "translation": "Louvai o Senhor, louvem os servos do Senhor, louvem o nome do Senhor."
  },
  {
    "verse": 2,
    "original": "<span data-strong=\"H1961\">יְהִ֤י</span> <span data-strong=\"H8034\">שֵׁ֣ם</span> <span data-strong=\"H3068\">יְהֹוָ֣ה</span> <span data-strong=\"H1288\">מְבֹרָ֑ךְ</span> <span data-strong=\"H6258\">מֵ֝עַתָּ֗ה</span> <span data-strong=\"H5704\">וְעַד</span>־<span data-strong=\"H5769\">עוֹלָֽם׃</span>",
    "transliteration": "yehiy shem yehovah mevorakhe me'atah ve'ad-'volam.",
    "translation": "Seja abençoado o nome do Senhor, desde agora e para sempre."
  },
  {
