  {
    "verse": 8,
    "original": "<span data-strong=\"H3427\">לְהוֹשִׁיבִ֥י</span> <span data-strong=\"H5973\">עִם</span>־<span data-strong=\"H5081\">נְדִיבִ֑ים</span> <span data-strong=\"H5973\">עִ֝֗ם</span> <span data-strong=\"H5081\">נְדִיבֵ֥י</span> <span data-strong=\"H2050\">עַמּֽוֹ׃</span>",
