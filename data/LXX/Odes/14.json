[
  {
    "pk": 1434234,
    "verse": 1,
    "text": "δόξα ἐν ὕψιστος θεός"
  },
  {
    "pk": 1434235,
    "verse": 2,
    "text": "καί ἐπί γῆ εἰρήνη"
  },
  {
    "pk": 1434236,
    "verse": 3,
    "text": "ἐν ἄνθρωπος εὐδοκία"
  },
  {
    "pk": 1434237,
    "verse": 4,
    "text": "αἰνέω σύ"
  },
  {
    "pk": 1434238,
    "verse": 5,
    "text": "εὐλογέω σύ"
  },
  {
    "pk": 1434239,
    "verse": 6,
    "text": "προςκυνέω σύ"
  },
  {
    "pk": 1434240,
    "verse": 7,
    "text": "δοξολογέω σύ"
  },
  {
    "pk": 1434241,
    "verse": 8,
    "text": "εὐχαριστέω σύ"
  },
  {
    "pk": 1434242,
    "verse": 9,
    "text": "διά ὁ μέγας σύ δόξα"
  },
  {
    "pk": 1434243,
    "verse": 10,
    "text": "κύριος βασιλεύς"
  },
  {
    "pk": 1434244,
    "verse": 11,
    "text": "ἐπουράνιος"
  },
  {
    "pk": 1434245,
    "verse": 12,
    "text": "θεός πατήρ παντοκράτωρ"
  },
  {
    "pk": 1434246,
    "verse": 13,
    "text": "κύριος υἱός μονογενής"
  },
  {
    "pk": 1434247,
    "verse": 14,
    "text": "ἰησοῦς χριστός"
  },
  {
    "pk": 1434248,
    "verse": 15,
    "text": "καί ἅγιος πνεῦμα"
  },
  {
    "pk": 1434249,
    "verse": 16,
    "text": "κύριος ὁ θεός"
  },
  {
    "pk": 1434250,
    "verse": 17,
    "text": "ὁ ἀμνός ὁ θεός"
  },
  {
    "pk": 1434251,
    "verse": 18,
    "text": "ὁ υἱός ὁ πατήρ"
  },
  {
    "pk": 1434252,
    "verse": 19,
    "text": "ὁ αἴρω ὁ ἁμαρτία ὁ κόσμος"
  },
  {
    "pk": 1434253,
    "verse": 20,
    "text": "ἐλεέω ἐγώ"
  },
  {
    "pk": 1434254,
    "verse": 21,
    "text": "ὁ αἴρω ὁ ἁμαρτία ὁ κόσμος"
  },
  {
    "pk": 1434255,
    "verse": 22,
    "text": "προςδέχομαι ὁ δέησις ἐγώ"
  },
  {
    "pk": 1434256,
    "verse": 23,
    "text": "ὁ καταἧμαι ἐν δεξιός ὁ πατήρ"
  },
  {
    "pk": 1434257,
    "verse": 24,
    "text": "ἐλεέω ἐγώ"
  },
  {
    "pk": 1434258,
    "verse": 25,
    "text": "ὅτι σύ εἰμί μόνος ἅγιος"
  },
  {
    "pk": 1434259,
    "verse": 26,
    "text": "σύ εἰμί μόνος κύριος"
  },
  {
    "pk": 1434260,
    "verse": 27,
    "text": "ἰησοῦς χριστός"
  },
  {
    "pk": 1434261,
    "verse": 28,
    "text": "εἰς δόξα θεός πατήρ αμην"
  },
  {
    "pk": 1434262,
    "verse": 29,
    "text": "κατά ἕκαστος ἡμέρα εὐλογέω σύ"
  },
  {
    "pk": 1434263,
    "verse": 30,
    "text": "καί αἰνέω ὁ ὄνομα σύ εἰς ὁ αἰών"
  },
  {
    "pk": 1434264,
    "verse": 31,
    "text": "καί εἰς ὁ αἰών ὁ αἰών"
  },
  {
    "pk": 1434265,
    "verse": 32,
    "text": "καταἀξιόω κύριος καί ὁ ἡμέρα οὗτος"
  },
  {
    "pk": 1434266,
    "verse": 33,
    "text": "ἀναμάρτητος φυλάσσω ἐγώ"
  },
  {
    "pk": 1434267,
    "verse": 34,
    "text": "εὐλογητός εἰμί κύριος ὁ θεός ὁ πατήρ ἐγώ"
  },
  {
    "pk": 1434268,
    "verse": 35,
    "text": "καί αἰνετός καί δοξάζω ὁ ὄνομα σύ εἰς ὁ αἰών αμην"
  },
  {
    "pk": 1434269,
    "verse": 36,
    "text": "εὐλογητός εἰμί κύριος διδάσκω ἐγώ ὁ δικαίωμα σύ"
  },
  {
    "pk": 1434270,
    "verse": 37,
    "text": "εὐλογητός εἰμί κύριος διδάσκω ἐγώ ὁ δικαίωμα σύ"
  },
  {
    "pk": 1434271,
    "verse": 38,
    "text": "εὐλογητός εἰμί κύριος διδάσκω ἐγώ ὁ δικαίωμα σύ"
  },
  {
    "pk": 1434272,
    "verse": 39,
    "text": "κύριος καταφυγή γίγνομαι ἐγώ ἐν γενεά καί γενεά"
  },
  {
    "pk": 1434273,
    "verse": 40,
    "text": "ἐγώ εἶπον κύριος ἐλεέω ἐγώ"
  },
  {
    "pk": 1434274,
    "verse": 41,
    "text": "ἰάομαι ὁ ψυχή ἐγώ ὅτι ἁμαρτάνω σύ"
  },
  {
    "pk": 1434275,
    "verse": 42,
    "text": "κύριος πρός σύ καταφύγω"
  },
  {
    "pk": 1434276,
    "verse": 43,
    "text": "διδάσκω ἐγώ ὁ ποιέω ὁ θέλημα σύ ὅτι σύ εἰμί ὁ θεός ἐγώ"
  },
  {
    "pk": 1434277,
    "verse": 44,
    "text": "ὅτι παρά σύ πηγή ζωή"
