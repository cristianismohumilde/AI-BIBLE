  "he": [
    "רֵאשִׁית הִתְגָּרוּת בְּנֵי אוֹר",
    "בַּחֵיל בְּנֵי חֹשֶׁךְ",
    "בַּחֵיל בְּלִיָּעַל",
    "כִּתִּיִּים אֱדוֹם וּמוֹאָב",
    "וּבְנֵי עַמּוֹן וּפְלִשְׁתִּים",
    "וְחֵיל כִּתִּיִּים אַשּׁוּר",
    "בֹּגְדֵי בְרִית יִשְׂרָאֵל",
    "בְּנֵי לֵוִי בְּנֵי יְהוּדָה בְּנֵי בִנְיָמִין",
    "בְּגוֹלַת הַמִּדְבָּר יִלָּחֲמוּ בָהֶם",
    "בְּשׁוּבָם מִמִּדְבַּר הָעַמִּים",
    "לַחֲנוֹת בְּמִדְבַּר יְהוּדָה",
    "וְאַחֲרֵי הַנִּצָּחוֹן",
    "עָלוּ מִשָּׁם לְכָל גּוֹיֵי הַהֶבֶל",
    "יַד אֵל בְּכָל בָּשָׂר"
  ],
