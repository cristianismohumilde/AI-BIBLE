  "he": [
    "מֵרֹאשׁ מוֹצָאָיו הוּא",
    "בְּצֵאת הַשֶּׁמֶשׁ עַל הָאָרֶץ",
    "בְּמִלֹּאת הַשֶּׁמֶשׁ חֶשְׁבּוֹנָה",
    "אֲשֶׁר לֹא יָצָא מֵרֹאשׁ",
    "כִּי מִמְּקוֹר צֶדֶק מִשְׁפָּטַי",
    "וְאֵין עֲוֹן בְּלֵבָב",
    "כִּי לָאֵל הַצְּדָקָה",
    "וּבְיָדוֹ תַמִּים דֶּרֶךְ",
    "בְּדַעְתּוֹ כֹּל נִהְיֶה",
    "וּבְחָכְמָתוֹ יִכּוֹן כֹּל הָוֶה",
    "לִי אֵין מַשֵּׂא בָשָׂר",
    "כִּי לָאֵל צְדָקָה"
  ],
